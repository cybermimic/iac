# Copier en hosts.yml (ignoré par git) et adapter à ton parc de machines.
# Ne jamais committer d'IP/username réels si le repo devient public — ici ce
# n'est pas un secret mais reste spécifique à un déploiement.
#
# Inventaire unique du parc, utilisé par bootstrap/ansible et par les
# playbooks des features (features/*/ansible).
all:
  vars:
    # Ubuntu >= 25.10 : `sudo` est sudo-rs, qui reformate l'invite de mot de
    # passe (« [sudo: …] Mot de passe : ») ; Ansible ne la reconnaît pas et
    # échoue sur « Timed out waiting for become … password prompt ». Le sudo
    # classique reste installé sous le nom sudo.ws : l'utiliser.
    ansible_become_exe: sudo.ws
  children:
    k8s_nodes:
      hosts:
        nucboxg3-plus:
          ansible_host: 192.168.1.253
          ansible_user: hoarauv
