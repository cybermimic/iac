# Copier en terraform.tfvars et adapter. Ne jamais committer terraform.tfvars
# s'il contient une valeur spécifique à un déploiement non public — ici
# metallb_ip_range n'est pas un secret mais dépend de ton réseau local.

metallb_ip_range = "192.168.1.240-192.168.1.250" # vérifier que c'est hors plage DHCP du routeur

# IP fixe de l'ingress Traefik, prise dans metallb_ip_range. C'est l'IP à
# déclarer dans le DNS du routeur ou /etc/hosts (voir ADR-006).
ingress_load_balancer_ip = "192.168.1.240"

# kubeconfig_path n'a volontairement pas d'exemple ici : fournis-le via
# TF_VAR_kubeconfig_path=$KUBECONFIG, jamais en fichier committé.
